<div class="rounded-lg border border-gray-200 p-6 max-w-xl mx-auto mt-12 space-y-4">
  <h1 class="text-2xl font-semibold">Smoke check</h1>
  <p>
    Signed in as
    <strong><%= user.email_address %></strong>
    (<%= user.role %>)
  </p>

  <%= helpers.turbo_frame_tag "smoke-status" do %>
    <p class="text-sm text-gray-600">No smoke job enqueued yet.</p>
  <% end %>

  <%= helpers.button_to "Enqueue smoke job",
                        helpers.admin_smoke_enqueue_path,
                        method: :post,
                        class: "rounded bg-black text-white px-4 py-2" %>
</div>
