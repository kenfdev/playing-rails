<section class="space-y-4 border border-gray-200 rounded-lg p-5">
  <h2 class="font-semibold text-xl">Work history</h2>

  <% if profile.persisted? %>
    <ul class="space-y-4" id="work-histories">
      <% profile.work_histories.each do |entry| %>
        <li class="border border-gray-200 rounded p-4 space-y-2" id="<%= dom_id(entry) %>">
          <%= render "work_history_form", entry: entry %>
          <%= button_to "Remove",
                         profile_work_history_path(entry),
                         method: :delete,
                         data: { turbo_confirm: "Remove this work history entry?" },
                         class: "text-sm text-red-600 underline hover:no-underline cursor-pointer" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="border border-dashed border-gray-300 rounded p-4">
    <h3 class="font-medium mb-3">Add a work history entry</h3>
    <%= render "work_history_form", entry: WorkHistory.new %>
  </div>
</section>
