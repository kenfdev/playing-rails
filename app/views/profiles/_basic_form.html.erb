<section class="space-y-4 border border-gray-200 rounded-lg p-5">
  <h2 class="font-semibold text-xl">Basic info</h2>

  <% if profile.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg">
      <ul class="list-disc list-inside">
        <% profile.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: profile, url: profile_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium" %>
      <%= form.text_field :name, autocomplete: "name",
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <%= form.label :headline, class: "block text-sm font-medium" %>
      <%= form.text_field :headline, placeholder: "Senior backend engineer at Acme",
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <%= form.label :bio, class: "block text-sm font-medium" %>
      <%= form.text_area :bio, rows: 5,
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= form.submit "Save basic info",
                    class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
</section>
