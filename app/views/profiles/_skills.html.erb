<section class="space-y-4 border border-gray-200 rounded-lg p-5">
  <h2 class="font-semibold text-xl">Skills</h2>

  <% if profile.persisted? && profile.skills.any? %>
    <ul class="flex flex-wrap gap-2" id="skills">
      <% profile.skills.each do |skill| %>
        <li class="flex items-center gap-2 bg-gray-100 rounded-full px-3 py-1 text-sm" id="<%= dom_id(skill) %>">
          <span><%= skill.name %></span>
          <%= button_to "×",
                         profile_skill_path(skill),
                         method: :delete,
                         data: { turbo_confirm: "Remove #{skill.name}?" },
                         class: "text-red-600 hover:text-red-800 cursor-pointer leading-none",
                         form_class: "inline" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: Skill.new, url: profile_skills_path, scope: :skill, class: "flex gap-2" do |form| %>
    <%= form.text_field :name, required: true, placeholder: "Add a skill",
                        class: "shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 flex-1" %>
    <%= form.submit "Add",
                    class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
</section>
