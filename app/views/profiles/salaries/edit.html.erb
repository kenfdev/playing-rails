<div class="mx-auto md:w-2/3 w-full space-y-8">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg" id="notice"><%= notice %></p>
  <% end %>

  <header class="space-y-2">
    <h1 class="font-bold text-3xl">Salary (private)</h1>
    <p class="text-gray-600 text-sm">
      Only you can see these values right now. They never appear on your public profile.
    </p>
  </header>

  <section class="space-y-4 border border-gray-200 rounded-lg p-5">
    <% if @salary.errors.any? %>
      <div class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg">
        <ul class="list-disc list-inside">
          <% @salary.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @salary, url: profile_salary_path, method: :patch, class: "space-y-6" do |form| %>
      <div>
        <h2 class="font-semibold text-xl">Current salary</h2>
        <%= form.label :current_amount, "Current annual salary", class: "block text-sm font-medium mt-3" %>
        <%= form.number_field :current_amount, min: 0,
                              class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>

      <fieldset class="space-y-4">
        <legend class="font-semibold text-xl">Expected salary range</legend>
        <div>
          <%= form.label :expected_min, "Minimum", class: "block text-sm font-medium" %>
          <%= form.number_field :expected_min, min: 0,
                                class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
        <div>
          <%= form.label :expected_max, "Maximum", class: "block text-sm font-medium" %>
          <%= form.number_field :expected_max, min: 0,
                                class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
      </fieldset>

      <%= form.submit "Save salary",
                      class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <% end %>
  </section>

  <%= link_to "Back to profile", edit_profile_path,
              class: "text-blue-600 underline hover:no-underline" %>
</div>
