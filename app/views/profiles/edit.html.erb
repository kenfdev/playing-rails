<div class="mx-auto md:w-2/3 w-full space-y-10">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg" id="notice"><%= notice %></p>
  <% end %>

  <header class="space-y-2">
    <h1 class="font-bold text-3xl">Edit profile</h1>
    <% if @profile.profile_updated_at.present? %>
      <p class="text-gray-600 text-sm" id="profile-last-updated">
        Last updated <%= @profile.profile_updated_at.to_fs(:long) %>
      </p>
    <% end %>
  </header>

  <%= render "profiles/basic_form",     profile: @profile %>
  <%= render "profiles/work_histories", profile: @profile %>
  <%= render "profiles/educations",     profile: @profile %>
  <%= render "profiles/skills",         profile: @profile %>

  <% if Current.user&.member? %>
    <aside class="border border-gray-200 rounded-lg p-5 space-y-2 bg-gray-50">
      <h2 class="font-semibold text-xl">Salary (private)</h2>
      <p class="text-gray-600 text-sm">
        Salary information is kept on a separate page and never appears on your public profile.
      </p>
      <%= link_to "Edit salary", edit_profile_salary_path,
                  class: "text-blue-600 underline hover:no-underline" %>
    </aside>
  <% end %>
</div>
