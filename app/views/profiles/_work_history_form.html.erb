<%
  url    = entry.persisted? ? profile_work_history_path(entry) : profile_work_histories_path
  method = entry.persisted? ? :patch : :post
%>
<%= form_with model: entry, url: url, method: method, scope: :work_history, class: "space-y-3" do |form| %>
  <% if entry.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg">
      <ul class="list-disc list-inside">
        <% entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= form.label :company, class: "block text-sm font-medium" %>
      <%= form.text_field :company, required: true,
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <%= form.label :title, class: "block text-sm font-medium" %>
      <%= form.text_field :title, required: true,
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <%= form.label :start_date, class: "block text-sm font-medium" %>
      <%= form.date_field :start_date, required: true,
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <%= form.label :end_date, "End date (leave blank if current)", class: "block text-sm font-medium" %>
      <%= form.date_field :end_date,
                          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium" %>
    <%= form.text_area :description, rows: 3,
                        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <%= form.submit (entry.persisted? ? "Save changes" : "Add work history"),
                  class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<% end %>
