<div class="mx-auto md:w-2/3 w-full space-y-6">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <header class="space-y-2">
    <h1 class="font-bold text-3xl">Welcome, <%= Current.user.email_address %></h1>
    <p class="text-gray-600">Signed in as <strong><%= Current.user.role %></strong>.</p>
  </header>

  <nav class="space-y-2">
    <% if Current.user.admin? %>
      <%= link_to "Admin smoke check", admin_smoke_path, class: "text-blue-600 underline hover:no-underline block" %>
    <% end %>

    <%= button_to "Sign out", session_path, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 text-white inline-block font-medium cursor-pointer" %>
  </nav>
</div>
